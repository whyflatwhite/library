# Локальный запуск без Docker
DATABASE_URL=postgresql+psycopg://library_user:library_pass@localhost:5432/library
APP_PORT=8000
APP_ENV=local
LOG_LEVEL=INFO

# Docker Compose (файл .env в git не попадает, пароль замените на свой)
POSTGRES_USER=library_user
POSTGRES_PASSWORD=library_pass
POSTGRES_DB=library
